models:
    User: { name: string, email: string, email_verified_at: 'datetime nullable', password: string, remember_token: 'string nullable', two_factor_secret: 'text nullable', two_factor_recovery_codes: 'text nullable', two_factor_confirmed_at: 'datetime nullable' }
    Form: { id: ulid, user_id: 'foreign:users.id', name: 'string:400', active: 'boolean default:false', schema: 'json nullable', settings: 'json nullable', timestamps: timestamps, softdeletes: softDeletes }
    FormEntry: { id: ulid, form_id: 'foreign:forms.id', data: 'json nullable', ip: 'string nullable', ip_location_display: 'string nullable', referer: 'string nullable', user_agent: 'string nullable', user_agent_display: 'string nullable', spam: 'boolean nullable', spam_score: 'decimal default:0', spam_reason: 'string nullable', starred: 'boolean default:false', read_at: 'timestamp nullable', timestamps: timestamps, softdeletes: softDeletes }
    FormNotification: { id: ulid, form_id: 'foreign:forms.id', type: 'enum:email,sms', value: string, enabled: 'boolean default:true', error: 'string nullable', timestamps: timestamps, softdeletes: softDeletes }
